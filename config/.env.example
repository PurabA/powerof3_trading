# ==============================================================================
# KOTAK NEO & TELEGRAM CREDENTIALS
# ==============================================================================

# 1. Kotak Neo Trade API Token (Called "API Access Token" or "Consumer Key")
# Copy the token directly from Kotak Neo App / Web: More tab -> Trade API -> Copy Token
KOTAK_NEO_CONSUMER_KEY="your_api_access_token_here"
KOTAK_NEO_ENVIRONMENT="prod"

# 2. Your Account Credentials
KOTAK_NEO_MOBILE_NUMBER="+91XXXXXXXXXX"
KOTAK_NEO_UCC="your_ucc_client_code"
KOTAK_NEO_MPIN="your_6_digit_mpin"

# 3. Automated 2FA TOTP Secret (OPTIONAL):
# If you have the alphanumeric setup key from when you scanned the QR code, paste it here
# to enable 100% zero-touch automated login every morning on your GCloud server.
# If you don't have it, leave it empty! The CLI will simply prompt you to enter the 6 digits from your phone.
KOTAK_NEO_TOTP_SECRET=""

# 4. Telegram Notifications (Broadcasts to your 3 Chat IDs)
TELEGRAM_BOT_TOKEN="your_telegram_bot_token_here"
TELEGRAM_CHAT_IDS="111111111,222222222,333333333"
